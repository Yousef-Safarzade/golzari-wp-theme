<!DOCTYPE html>

<html lang="fa" dir="rtl">

<head>

    <meta charset="UTF-8">


</head>


<body>

<div class="golzari-ticket-pdf-main-wrapper">


    <div class="golzari-pdf-ticket-header">

        <div class="golzari-ticket-logo">

            <img src="https://golzariart.ir/wp-content/uploads/2026/08/Frame-3472492.png">

        </div>

        <div class="clearfix"></div>

    </div>





    <h1 class="golzari-ticket-section-title">اطلاعات محصول</h1>



    {% for ticket in tickets %}

        <div class="golzari-ticket-content">

            <div class="golzari-ticket-content-right-col">

                <img src="{{ ticket.ticketImageURL }}">

            </div>


            <div class="golzari-ticket-content-left-col">

                <div class="golzari-ticket-product-data-row">

                    <span style="float: right"><Strong>عنوان :</Strong></span>

                    <span>{{ ticket.ticketTitle }}</span>

                </div>




                <div class="golzari-ticket-product-data-row">


                    <span style="float: right"><Strong>  تاریخ :</Strong></span>

                    <span>{{ ticket.ticketDate }}</span>


                </div>



                <div class="golzari-ticket-product-data-row">


                    <span style="float: right"><Strong>آدرس :</Strong></span>

                    <span>{{ ticket.ticketAddress }}</span>

                </div>

                <div class="golzari-ticket-product-data-row">

                    <strong>توضیحات :</strong>

                    <p>{{ ticket.ticketDescription }}</p>

                </div>

            </div>

        {% endfor %}

        <div class="clearfix"></div>

    </div>













    <h1 class="golzari-ticket-section-title">اطلاعات مشتری</h1>

    <div class="golzari-ticket-content ">


        <div class="golzari-ticket-content-left-col">

            <div class="golzari-ticket-product-data-row">

                <span><strong>نام :</strong></span>

                <span>{{ ticketBuyerName }}</span>

            </div>




            <div class="golzari-ticket-product-data-row">

                <span><strong>شماره تماس :</strong></span>

                <span>{{ ticketBuyerPhoneNumber }}</span>

            </div>



            <div class="golzari-ticket-product-data-row">

                <span><strong>کد ملی :</strong></span>

                <span>{{ ticketBuyerMeliCode }}</span>

            </div>

        </div>

        <div class="clearfix"></div>

    </div>









    <h1 class="golzari-ticket-section-title">اطلاعات پرداخت</h1>

    <div class="golzari-ticket-content ">

        <div class="golzari-ticket-content-left-col">

            <div class="golzari-ticket-product-data-row">

                <span><Strong>شماره سفارش :</Strong></span>

                <span>{{ orderCode }}</span>

            </div>

            <div class="golzari-ticket-product-data-row">

                <span><strong>تاریخ :</strong></span>

                <span>{{ orderDate }}</span>

            </div>

            <div class="golzari-ticket-product-data-row">

                <span><strong>تعداد :</strong></span>

                <span>{{ orderQuantity }}</span>

            </div>

            <div class="golzari-ticket-product-data-row">

                <span><strong>مبلغ :</strong></span>

                <span>{{ orderTotalCost }}</span>

            </div>

        </div>

        <div class="clearfix"></div>

    </div>






</div>

</body>


<style>



    body{

        direction: rtl;
        text-align: right;


    }

    .clearfix::after {

        content: "";

        clear: both;

        display: table;

    }



    .golzari-ticket-pdf-main-wrapper{

        border : 1px solid #4A4A5A;

        border-radius: 12px;

        width: 100%;

        height: 99%;

    }


    .golzari-pdf-ticket-header{

        width: 90%;

        height: 80px;

        margin : 20px auto 20px auto ;

        border-bottom: 1px solid #4A4A5A;
    }


    .golzari-ticket-section-title{

        width: 90%;

        margin: 0 auto;

        font-size: 16px;

        font-weight: 400;

        line-height: 1.7em;

    }

    .golzari-ticket-logo{

        float: right;

    }


    .golzari-ticket-content{

        width: 90%;

        margin : 10px auto 20px auto ;

        border-radius: 12px;

        background: #F7F7F7;

        padding: 15px;

    }



    .golzari-ticket-content-right-col{

        width: 150px;


        float: right;

    }


    .golzari-ticket-content-left-col{

        float: right;

        width: 65%;

        margin-right: 20px;

    }





    .golzari-ticket-main-image{

        width: 200px;

        height: auto;

        border-radius: 12px;

    }



    .golzari-ticket-product-data-row{

        margin-bottom: 5px;



    }

    .golzari-ticket-product-data-row strong{

        display: block;

        font-size:12px;

        line-height: 1.7em;

        font-weight: 400;

    }

    .golzari-ticket-product-data-row p,.golzari-ticket-product-data-row span,.golzari-ticket-product-data-row bdi {

        font-size:12px;

        line-height: 1.9em;

        font-weight: 300;

        display: inline-block;

        margin-top: 5px;

        margin-bottom: 0;

    }


</style>

</html>

